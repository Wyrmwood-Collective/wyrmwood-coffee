# Copy this file to .env.local, then update:
#   - DEV_DATABASE_URL
#   - TEST_DATABASE_URL
#   - JWT_SECRET_KEY
# The defaults should be fine for all other settings.

# This file (.env.example) is safe to commit, but .env.local is not.
# See docs/configuration.md for more information.

# Update with your own local dev and test databases.
DEV_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/wyrmwood_coffee
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/wyrmwood_coffee_test

# Update with a secret key (geenrate one with `openssl rand -base64 32`).
JWT_SECRET_KEY=change-me-must-be-at-least-32-characters

# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=30

# LOG_LEVEL=INFO # DEBUG, INFO, WARNING (default), ERROR, CRITICAL
