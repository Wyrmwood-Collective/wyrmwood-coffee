# Copy this file to .env.local, then replace the fake values.
# This file (.env.example) is safe to commit. .env.local is not.
#
# APP_ENVIRONMENT: "dev" on your laptop, "test" in pytest/CI, "staging" when deployed.
# DEV_DATABASE_URL: your local Postgres. TEST_DATABASE_URL: local test database.
# STAGING_DATABASE_URL: deployed database (set on the host, not in git).
# JWT_SECRET_KEY: a long random string you generate; not the placeholder below.
# See docs/configuration.md for a slower walkthrough.

APP_ENVIRONMENT=dev
DEV_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/wyrmwood_coffee
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/wyrmwood_coffee_test
STAGING_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/wyrmwood_coffee
JWT_SECRET_KEY=change-me-must-be-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# LOG_LEVEL=INFO # DEBUG, INFO, WARNING (default), ERROR, CRITICAL
